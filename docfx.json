{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "build": {
    "content": [
      {
        "files": ["**/*.{md,yml}"],
        "exclude": ["pages/**"]
      }
    ],
    "resource": [
      {
        "files": ["images/**"]
      }
    ],
    "output": "pages",
    "template": ["default", "modern"],
    "globalMetadata": {
      "_appName": "CSharpRecruit",
      "_appTitle": "CSharpRecruit",
      "_enableSearch": false,
      "pdf": false
    }
  }
}
